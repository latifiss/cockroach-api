NODE_ENV=development
PORT=5000

MONGODB_URI=your_mongodb_connection_string
MONGODB_DB_NAME=api
MONGODB_API_MAX_POOL_SIZE=3
MONGODB_SCHEDULER_MAX_POOL_SIZE=6
MONGO_PERSISTENCE_CONCURRENCY=3

COLLECTION_CONCURRENCY=8
COLLECTION_TIMEOUT_MS=20000
COLLECTION_RETRY_ATTEMPTS=1
COLLECTION_RETRY_DELAY_MS=500

OPS_API_TOKEN=your-long-random-secret
SOURCE_POLL_INTERVAL_MS=300000
INTELLIGENCE_DEBOUNCE_MS=10000
INTELLIGENCE_LOOKBACK_HOURS=6
INTELLIGENCE_ARTICLE_LIMIT=1000
